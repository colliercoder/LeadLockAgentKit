# Leadlock API credentials
# Get your key from https://app.leadlock.ai/dashboard/settings/api-keys

LEADLOCK_API_KEY=sk_live_paste_your_key_here

# Production API host. Leave as-is unless Leadlock support tells you otherwise.
LEADLOCK_API_URL=https://leadlock-app.onrender.com

# ── Your phone (recommended) ───────────────────────────────────────────────
# Your own cell in +1 format, so the kit can call you to test agents and calls.
# Skills that place a test call (build-agent, prospect-demo, prompt-tuner)
# default to this number and always ask before dialing. Example: +15555550123
MY_PHONE_NUMBER=

# ── Twilio (optional) ──────────────────────────────────────────────────────
# Lets Claude Code work with your Twilio account directly: list your numbers,
# check A2P 10DLC registration status, read call logs, and force-end a stuck
# test call (the runaway-call backstop in agent-to-agent-call-testing).
# Find both on the Twilio Console home page (https://console.twilio.com),
# under "Account Info". The Account SID starts with "AC".
# Older kit versions used LEADLOCK_TWILIO_SID / LEADLOCK_TWILIO_AUTH; those still
# work as a fallback, but these names win when both are set.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ── retell-to-leadlock skill only ──────────────────────────────────────────
# Required to PORT a Retell agent into Leadlock (the source platform, read-only).
# Get it from the Retell dashboard: https://dashboard.retellai.com → API Keys
# Leave blank if you're not porting from Retell.
RETELL_API_KEY=key_paste_your_retell_key_here

# Optional: only if your Retell agent's custom tools hit your OWN backend
# (e.g. a Modal/cal.com booking wrapper) and you need to deploy the webhook
# envelope bridge adapter. Leave commented out otherwise.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# ── agent-to-agent-call-testing skill (all optional) ───────────────────────
# The runaway-call backstop (force-ends a stuck two-bot call) uses
# TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN above. Without them, each test agent's
# end_call tool plus a 2-3 min duration cap bound the cost, so they are only a
# safety net.
# Target a specific sub-account when using an agency-tier key.
# LEADLOCK_SUB_ACCOUNT_ID=

# ── n8n (install-support-team skill) ─────────────────────────────────────────
# Your n8n address (n8n Cloud looks like https://you.app.n8n.cloud) and an n8n API
# key (n8n: Settings > n8n API > Create an API key). The installer uses them to
# create the support team's data tables, workflows and webhook credential.
N8N_API_URL=
N8N_API_KEY=
# Written by the installer: the shared secret Leadlock sends to your n8n webhooks.
# SUPPORT_TEAM_WEBHOOK_SECRET=

# ── GoHighLevel (self-selling-setup skill and the Launch Bundle add-on) ─────
# Used by self-selling-setup to auto-fill GHL custom values, and copied into the
# Launch Bundle's GHL CLI by install-addon.
# GHL sub-account Location ID (the long string in your GHL URL).
GHL_LOCATION_ID=
# GHL Private Integration Token. Create at Settings -> Private Integrations
# with the customValues read + write scopes. Starts with "pit-".
GHL_PIT=pit-paste-your-token-here
