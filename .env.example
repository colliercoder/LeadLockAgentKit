# Leadlock API credentials
# Get your key from https://app.leadlock.ai/dashboard/settings/api-keys

LEADLOCK_API_KEY=sk_live_paste_your_key_here

# Production API host. Leave as-is unless Leadlock support tells you otherwise.
LEADLOCK_API_URL=https://leadlock-app.onrender.com

# ── retell-to-leadlock skill only ──────────────────────────────────────────
# Required to PORT a Retell agent into Leadlock (the source platform, read-only).
# Get it from the Retell dashboard: https://dashboard.retellai.com → API Keys
# Leave blank if you're not porting from Retell.
RETELL_API_KEY=key_paste_your_retell_key_here

# Optional — only if your Retell agent's custom tools hit your OWN backend
# (e.g. a Modal/cal.com booking wrapper) and you need to deploy the webhook
# envelope bridge adapter. Leave commented out otherwise.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# ── agent-to-agent-call-testing skill (all optional) ───────────────────────
# Twilio creds for the runaway-call backstop (force-ends a stuck two-bot call).
# Without them, each test agent's end_call tool plus a 2-3 min duration cap
# bound the cost, so these are only a safety net.
# LEADLOCK_TWILIO_SID=
# LEADLOCK_TWILIO_AUTH=
# Target a specific sub-account when using an agency-tier key.
# LEADLOCK_SUB_ACCOUNT_ID=
